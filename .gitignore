# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# NOTE: we intentionally commit the android/ project (incl. signing config +
# keystore) for this private study repo. Only build outputs are ignored below.

# Android build artifacts (regenerated; not source)
android/app/build/
android/build/
android/.gradle/
android/.kotlin/
**/.cxx/
node_modules/react-native-screens/android/build/

# Model chunks (huge; regenerated by npm run split-model)
assets/model/chunk-*.bin
models/*.gguf

# Analysis: private repo — config.py (with keys) IS committed on purpose.
# Ignore only generated PDFs, the redundant example, and caches.
analysis/*.pdf
analysis/config.example.py
__pycache__/
assets/model/manifest.json
assets/model/chunks.ts
